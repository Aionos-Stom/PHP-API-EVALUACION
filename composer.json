{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "devops/productos-divisas-api",
  "type": "project",
  "description": "Prueba Backend: API Laravel de productos y precios en distintas divisas.",
  "license": "proprietary",
  "require": {
    "php": ">=8.5.12 <8.6",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "laravel/framework": "^13.17"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  },
  "config": {
    "allow-plugins": false,
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "secure-http": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
