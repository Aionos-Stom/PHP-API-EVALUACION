{
  "info": {
    "name": "Prueba Backend — Productos y divisas",
    "description": "API Laravel de productos y precios en diferentes divisas. Configura base_url y api_token; ejecuta Crear producto para guardar product_id automáticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8088"
    },
    {
      "key": "api_token",
      "value": ""
    },
    {
      "key": "product_id",
      "value": ""
    },
    {
      "key": "base_currency_id",
      "value": "1"
    },
    {
      "key": "alternate_currency_id",
      "value": "2"
    }
  ],
  "item": [
    {
      "name": "Crear producto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/products",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "products"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Teclado\",\n  \"description\": \"Teclado mecánico compacto\",\n  \"Price\": \"1500.50\",\n  \"currency_id\": \"{{base_currency_id}}\",\n  \"tax_cost\": \"270.09\",\n  \"manufacturing_cost\": \"700.00\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) { pm.collectionVariables.set('product_id', pm.response.json().data.id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar productos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/products",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "products"
          ]
        }
      }
    },
    {
      "name": "Consultar producto",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/products/{{product_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "products",
            "{{product_id}}"
          ]
        }
      }
    },
    {
      "name": "Actualizar producto completo",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/products/{{product_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "products",
            "{{product_id}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Teclado actualizado\",\n  \"description\": \"Teclado mecánico compacto\",\n  \"Price\": \"1700.00\",\n  \"currency_id\": \"{{base_currency_id}}\",\n  \"tax_cost\": \"270.09\",\n  \"manufacturing_cost\": \"700.00\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Listar precios",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/products/{{product_id}}/prices",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "products",
            "{{product_id}}",
            "prices"
          ]
        }
      }
    },
    {
      "name": "Registrar precio en USD",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/products/{{product_id}}/prices",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "products",
            "{{product_id}}",
            "prices"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currency_id\": \"{{alternate_currency_id}}\",\n  \"price\": \"28.33\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Eliminar producto y sus precios",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/products/{{product_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "products",
            "{{product_id}}"
          ]
        }
      }
    }
  ]
}
